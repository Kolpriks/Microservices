{
  "dashboard": {
    "title": "Microservices Logs",
    "tags": ["microservices", "loki", "logs"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Service Logs",
        "type": "logs",
        "gridPos": {"h": 20, "w": 24, "x": 0, "y": 0},
        "targets": [
          {
            "expr": "{container_name=~\".*\"}",
            "refId": "A",
            "legendFormat": "{{container_name}}"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": false,
          "showTime": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 2,
        "title": "Error Logs",
        "type": "logs",
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 20},
        "targets": [
          {
            "expr": "{container_name=~\".*\"} |= \"error\" |=\"Error\" |=\"ERROR\"",
            "refId": "A"
          }
        ],
        "options": {
          "dedupStrategy": "none",
          "enableLogDetails": true,
          "prettifyLogMessage": false,
          "showCommonLabels": false,
          "showLabels": true,
          "showTime": true,
          "sortOrder": "Descending"
        }
      },
      {
        "id": 3,
        "title": "Log Volume by Service",
        "type": "graph",
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 20},
        "targets": [
          {
            "expr": "sum(count_over_time({container_name=~\".*\"}[1m])) by (container_name)",
            "legendFormat": "{{container_name}}",
            "refId": "A"
          }
        ],
        "yaxes": [
          {"format": "short", "label": "Log lines/min"},
          {"format": "short"}
        ]
      }
    ],
    "schemaVersion": 27,
    "version": 1,
    "refresh": "10s"
  }
}

